    "settingsPrivacyDataBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You use MMA ScoreCard without an account. The app does not ask for your name, email or password, and does not send personal data to any server we operate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usas MMA ScoreCard sin cuenta. La app no te pide nombre, correo ni contraseña, y no envía datos personales a ningún servidor que operemos."
          }
        }
      }
    },
    "settingsPrivacyDataTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta"
          }
        }
      }
    },
    "settingsPrivacyInfraBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Public event listings are fetched from a third-party source over HTTPS and cached only on this device so the app does not re-download them every time. Theme, language and the biometric unlock setting stay on the device. You can clear the local event cache by clearing the app's storage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los listados públicos de eventos se obtienen de una fuente externa por HTTPS y se guardan en caché solo en este dispositivo para no volver a descargarlos cada vez. El tema, el idioma y el ajuste de desbloqueo biométrico se quedan en el dispositivo. Puedes borrar la caché local de eventos al borrar el almacenamiento de la app."
          }
        }
      }
    },
    "settingsPrivacyInfraTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What we store"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué guardamos"
          }
        }
      }
    },
    "settingsPrivacyNoticeBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This policy may be updated as the app changes. Continued use of the app after changes means you accept the updated policy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta política puede actualizarse a medida que la app cambie. El uso continuado de la app después de esos cambios implica la aceptación de la política actualizada."
          }
        }
      }
    },
    "settingsPrivacyNoticeTitle" : {
      "extractionState" : "manual",
      "localizations" : {
