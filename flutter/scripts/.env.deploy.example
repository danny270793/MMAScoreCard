# Copy to scripts/.env.deploy (gitignored). KEY=value, no spaces around "=".

# Firebase project ID (Project settings > General). Optional if you ran `firebase use`.
FIREBASE_PROJECT_ID=danny-apps-ec658

# App IDs: Project settings > Your apps > App ID (looks like 1:1234567890:android:abc123...)
FIREBASE_ANDROID_APP_ID=1:122031324796:android:7233d5d94dde459f92d3f9
FIREBASE_IOS_APP_ID=

# At least one of these. Groups are the group *aliases* from App Distribution > Testers & Groups.
FIREBASE_GROUPS=testers
FIREBASE_TESTERS=

# iOS only: ad-hoc (registered devices) or development
IOS_EXPORT_METHOD=ad-hoc

# CI only: path to a service account JSON key instead of `firebase login`
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
