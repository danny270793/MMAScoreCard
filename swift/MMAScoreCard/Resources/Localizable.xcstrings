    "settingsPrivacySharingBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because event data is requested directly from that source, your device's network request (e.g. IP address) is visible to it per its own privacy practices, which this app does not control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como los datos se solicitan directamente a esa fuente, tu solicitud de red (por ejemplo, tu dirección IP) es visible para ella según sus propias prácticas de privacidad, que esta app no controla."
          }
        }
      }
    },
    "settingsPrivacySharingTitle" : {
      "extractionState" : "manual",
